{
  "schema_version": 1,
  "forward_acceptance": {
    "dimension_operator": ">",
    "threshold": 9.0,
    "unrounded": true,
    "target": 10.0,
    "no_average_waiver": true,
    "no_unresolved_mandatory_defect": true
  },
  "independence_rule": "A builder/self-review/persona swap is not an independent critic. Use a genuinely separate reviewer/model runtime when required; if unavailable, keep the independent gate BLOCKED.",
  "cost_rule": "No paid APIs or paid critic services.",
  "critics": {
    "C1": {
      "name": "Reference Fidelity Critic",
      "independent_model_required": true,
      "checks": [
        "authoritative reference-video fidelity",
        "visual-language match",
        "cross-view consistency"
      ]
    },
    "C2": {
      "name": "Technical / Visual Integrity Critic",
      "independent_model_required": true,
      "checks": [
        "geometry/contact",
        "clipping/seams",
        "intentional gaps versus defects",
        "cross-view integrity"
      ]
    },
    "C3": {
      "name": "Havenline Gameplay Identity Critic",
      "independent_model_required": true,
      "checks": [
        "Havenline feel",
        "one-joystick/simple-context philosophy",
        "core physical loop",
        "no unnecessary control complexity",
        "world response readability"
      ]
    },
    "C4": {
      "name": "Gameplay UX / Readability Critic",
      "independent_model_required": true,
      "checks": [
        "interactable target clarity",
        "danger clarity",
        "collection feedback",
        "resource destination",
        "world change clarity",
        "next-action clarity"
      ]
    },
    "C5": {
      "name": "Motion / Rigging Critic",
      "independent_model_required": true,
      "checks": [
        "full cycles",
        "foot strike",
        "stance",
        "toe-off",
        "knees/hips",
        "hands",
        "weight transfer",
        "transitions",
        "clipping",
        "tails/wings/mane/gear/contact"
      ]
    },
    "C6": {
      "name": "Performance Critic",
      "independent_model_required": false,
      "quantitative_specialist_gate": true,
      "checks": [
        "frame time",
        "draw calls",
        "geometry",
        "texture/memory",
        "shader cost",
        "physics",
        "animation",
        "NPC load",
        "thermal-risk indicators"
      ],
      "note": "Numeric performance gate; does not replace T68/T69 physical certification."
    },
    "C7": {
      "name": "Progression / Difficulty Critic",
      "independent_model_required": true,
      "checks": [
        "rising difficulty",
        "not HP-only inflation",
        "no impossible spikes",
        "no boring stretches",
        "meaningful upgrades",
        "bounded Challenge Director"
      ]
    },
    "C8": {
      "name": "Economy / Fairness Critic",
      "independent_model_required": true,
      "checks": [
        "F2P viability",
        "sources/sinks",
        "inflation",
        "VIP",
        "purchase value",
        "paywall risk",
        "no intentionally miserable F2P"
      ]
    },
    "C9": {
      "name": "Security / Exploit Critic",
      "independent_model_required": false,
      "adversarial_test_harness_required": true,
      "checks": [
        "save modification",
        "clock manipulation",
        "replay",
        "duplicate grants",
        "fake purchase",
        "fake premium balance",
        "VIP manipulation",
        "event fraud",
        "rollback",
        "leaderboard fabrication"
      ]
    },
    "C10": {
      "name": "LiveOps Critic",
      "independent_model_required": true,
      "checks": [
        "impossible requirements",
        "event collision",
        "reward values",
        "F2P feasibility",
        "duplicate rewards",
        "pricing/sales",
        "timing",
        "assets/localization"
      ]
    },
    "C11": {
      "name": "Accessibility Critic",
      "independent_model_required": true,
      "checks": [
        "touch targets",
        "UI scale",
        "text readability",
        "color differentiation",
        "reduced motion",
        "subtitles",
        "joystick layout",
        "controller",
        "phone/tablet/foldable states"
      ]
    }
  },
