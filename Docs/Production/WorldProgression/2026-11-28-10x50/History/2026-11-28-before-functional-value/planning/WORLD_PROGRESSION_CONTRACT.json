  "requirements": [
    {
      "id": "WP01",
      "status": "OWNER_FIXED",
      "text": "Ten worlds, exactly fifty local gameplay levels per world; five hundred total planned level positions."
    },
    {
      "id": "WP02",
      "status": "SOURCE_CARRIED_FORWARD",
      "text": "World 1 Frozen Home Camp is the initial release focus. Worlds 2–10 follow as connected updates; the sandbox continues after the current world milestone."
    },
    {
      "id": "WP03",
      "status": "OWNER_FIXED",
      "text": "Focus the current appearance-upgrade render work on World 1; preserve selected baseline appearances and existing approved references."
    },
    {
      "id": "WP04",
      "status": "PRESERVED_CONTRACT",
      "text": "Retain T01–T70 identities and dependencies/ownership. T71–T80 lack recovered definitions and remain undefined."
    },
    {
      "id": "WP05",
      "status": "PRESERVED_CONTRACT",
      "text": "Each authored level must produce a useful route, recipe, tool, worker capability, production choice, defense/recovery choice or visible world improvement; quantity-only repetition is insufficient."
    },
    {
      "id": "WP06",
      "status": "INTERFACE_PROPOSAL_NOT_MIGRATED",
      "text": "Represent world index/local level separately; derive a campaign ordinal only where needed. Global player-facing numbering and concrete saved-ID migration remain unresolved."
    },
    {
      "id": "WP07",
      "status": "PRESERVED_CONTRACT",
      "text": "World/player levels, equipment levels, visual appearance stages and purchase tiers are distinct; fifty world levels do not imply fifty models for every asset."
    },
    {
      "id": "WP08",
      "status": "RELEASE_SCOPE_RECONCILIATION_REQUIRED",
      "text": "A World 1 release must pass applicable economy, security, audio, reference, progression and physical-device gates for the shipped scope. Full five-hundred-level completion is a later campaign acceptance obligation. Do not waive or silently rewire the existing task dependency graph."
    },
    {
      "id": "WP09",
      "status": "PRESERVED_CONTRACT",
      "text": "Keep accepted quotes, paid value, actor unlocks, existing inventory and valid old receipts stable through migration; no automatic multiplication or remapping of old unlock levels."
    },
    {
      "id": "WP10",
      "status": "SOURCE_CARRIED_FORWARD",
      "text": "Garage-first snow truck, fence-line door, unlimited typed cargo, paid repair/replacement and outside-wreck cargo loss belong to World 1. Low fuel consumption is required under the later vehicle-economy instruction."
    },
    {
      "id": "WP11",
      "status": "NOT_IMPLEMENTED_HERE",
      "text": "This package changes forward planning and render requirements only. It does not implement five hundred levels, activate tasks, alter the game, or grant runtime/visual/animation/audio/device approval."
    }
  ],
