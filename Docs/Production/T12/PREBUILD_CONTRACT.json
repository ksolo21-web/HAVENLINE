  "dependency_gate": {
    "required_approved": [
      "T07",
      "T08",
      "T10",
      "T11"
    ],
    "runtime_allowed_before_gate": false,
    "activation_base": "exact integration head containing T10 and T11 APPROVED/integrated completion records",
    "stale_base_fails_closed": true
  },
  "product_contract": {
    "level_min": 1,
    "level_max": 100,
    "exact_shipping_level_record_count": 100,
    "practical_progression_every_level": true,
    "visible_improvement_target_max_gap_levels": 3,
    "major_milestone_target_interval_levels": 10,
    "connected_world": true,
    "zero_dollar_completion_required": true,
    "energy_wall_forbidden": true,
    "purchase_or_vip_gated_level_eligibility_forbidden": true,
    "difficulty_owner": "T13",
    "persistence_owner": "T14",
    "economy_owner": "T33+",
    "authored_region_owner": "T44-T52"
  },
  "level_record_schema": {
    "required_fields": [
      "level",
      "level_id",
      "region_band_id",
      "prerequisite_level_ids",
      "required_fact_ids",
      "progression_effects",
      "visible_progression_hook_ids",
      "milestone_ids",
      "one_time_event_ids"
    ],
    "validation_rules": [
      "level is an integer 1..100",
      "level_id is exact canonical t12.level.NNN for its level and globally unique",
      "exactly one shipping record exists for each level 1..100",
      "region_band_id matches the frozen ten-level connected-world band",
      "every prerequisite target exists and points only to an earlier level",
      "Level 1 required_fact_ids is empty; Levels 2-100 contain exactly the matching T12-owned t12.fact.slot.NNN. External producer IDs resolve only through the binding index.",
      "prerequisite topology is acyclic and reachable from Level 1",
      "every level declares at least one practical progression effect or unlock and exact effect payloads cannot be reused as filler",
      "purchase/VIP/premium-spend/energy signals are not valid eligibility inputs",
      "each level includes canonical completion event t12.event.level.NNN.completed",
      "one-time event and visible-hook IDs are unique and deterministic",
      "milestone references resolve to the milestone dataset at the same level"
    ]
  },
  "milestone_schema": {
    "required_fields": [
      "milestone_id",
      "level",
      "kind",
      "progression_hook_ids",
      "visible_change_required",
      "owner_task"
    ],
    "validation_rules": [
      "milestone_id is unique and stable in t12.milestone namespace",
      "default major milestone at each ten-level boundary uses exact t12.milestone.NNN",
      "milestone level exists in Level 1..100 records",
      "progression_hook_ids contain no preparation-only/provisional IDs",
      "owner_task identifies the task responsible for shipping content/behavior",
      "T12 metadata cannot claim later-owner content is already implemented"
    ]
  },
  "region_band_contract": [
