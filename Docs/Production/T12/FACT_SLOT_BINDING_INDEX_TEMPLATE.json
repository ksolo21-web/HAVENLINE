{
  "schema_version": 1,
  "task_id": "T12",
  "status": "PREPARATION_ONLY_FACT_SLOT_BINDING_INDEX_TEMPLATE",
  "shipping_path_forbidden": true,
  "purpose": "Activation/build-time template for mapping stable T12 fact slots to authoritative producer facts. Preparation freezes slot semantics only; exact source IDs remain blank until trusted accepted producers exist.",
  "source_catalog_blob_sha": "e09c8f774ba844eb1b04158eb94aa492cdbdfa67",
  "required_resolved_binding_shape": {
    "slot_id": "exact t12.fact.slot.NNN",
    "fact_kind": "one allowed fact kind for this slot",
    "source_task": "authoritative producer task/integration identity",
    "source_id": "exact accepted producer identifier",
    "resolution_state": "RESOLVED or DEFERRED_LATER_OWNER",
    "evidence_ref": "repository/evidence reference proving producer authority",
    "idempotency_domain": "stable domain used to prevent duplicate observation"
  },
  "rules": [
    "Level 1 has no required fact slot and therefore no binding entry.",
    "Every Level 2-100 slot appears exactly once.",
    "RESOLVED requires fact_kind within allowed_fact_kinds and a non-empty accepted source_id/evidence_ref.",
    "T10/T11 source IDs require activation-time BINDING_RESOLUTION proof.",
    "DEFERRED_LATER_OWNER is allowed only where later_owner_registration_allowed=true; deferred slots keep the level locked.",
    "No purchase, premium_spend, VIP, payer or energy signal may be a source fact.",
    "This template is not shipping progression data and cannot satisfy a slot by itself.",
    "Internal T12 presentation requirements are not authoritative fact kinds and can never resolve a fact slot.",
    "Opening-band activation-relevant Levels 3,4,6,9,10 must be RESOLVED at T12 activation; DEFERRED_LATER_OWNER is forbidden for them.",
    "Resolved opening activation rows must collectively include at least one T10 source_task and at least one T11 source_task."
  ],
