{
  "schema_version": 1,
  "authority": "Havenline hard visual-quality rule",
  "effective_date": "2026-09-22",
  "rule": "No task may be effectively APPROVED or enter INTEGRATION_READY with primitive/placeholder shipping art OR a whole-frame reference-fidelity mismatch. Final review judges the complete rendered scene, including visible upstream dependencies.",
  "shipping_roots": [
    "HavenlineGodot/"
  ],
  "excluded_patterns": [
    "HavenlineGodot/tests/**",
    "HavenlineGodot/tools/**",
    "HavenlineGodot/**/*.uid"
  ],
  "forbidden_render_types": [
    "BoxMesh",
    "CapsuleMesh",
    "CylinderMesh",
    "PlaneMesh",
    "PointMesh",
    "PrimitiveMesh",
    "PrismMesh",
    "QuadMesh",
    "RibbonTrailMesh",
    "SphereMesh",
    "TextMesh",
    "TorusMesh",
    "TubeTrailMesh"
  ],
  "forbidden_material_types": [
    "StandardMaterial3D",
    "ORMMaterial3D"
  ],
  "text_extensions": [
    ".gd",
    ".tscn",
    ".tres",
    ".res",
    ".gdshader",
    ".material"
  ],
  "human_visual_gate": {
    "required_for_new_or_repaired_visual_approval": true,
    "governance_record_pattern": "Docs/Production/VisualApprovals/{task_id}/{candidate_sha}.json",
    "minimum_stills": 4,
    "minimum_motion_seconds": 3,
    "minimum_internal_resolution": [
      3840,
      2160
    ],
    "minimum_capture_fps": 60,
    "exact_candidate_required": true,
    "primitive_audit_zero_findings_required": true,
    "explicit_user_visual_approval_required": true,
    "note": "This source-bound 4K60 visual proof is an approval-viewing requirement; final sustained physical-device native 4K60 certification remains a later release gate.",
    "reference_fidelity_side_by_side_required": true,
    "whole_frame_review_required": true,
    "zero_failed_visible_asset_classes_required": true,
    "user_rejection_blocks_until_new_candidate": true,
    "critic_pass_cannot_override_user_rejection": true
  },
  "visual_critic_ids": [
    "C1",
    "C2",
    "C3",
    "C4",
    "C5",
    "C11"
  ],
  "effective_approval": {
    "historical_approved_status_alone_is_insufficient": true,
    "active_invalidation_revokes_effective_approval": true,
    "uncovered_primitive_finding_revokes_effective_approval": true,
    "dependency_gates_must_use_effective_approval": true,
    "no_grandfathering_of_known_primitive_violations": true,
    "reference_fidelity_failure_revokes_effective_approval": true,
    "user_visual_rejection_revokes_effective_approval": true,
    "upstream_visible_dependency_failure_blocks_downstream_visual_approval": true
  },
  "whole_game_release": {
    "audit_all_shipping_paths": true,
    "include_integration_only_paths": true,
    "primitive_findings_allowed": 0,
    "reference_fidelity_failed_visible_classes_allowed": 0
  },
  "reference_fidelity_standard": "Docs/Production/REFERENCE_FIDELITY_STANDARD.json"
}
