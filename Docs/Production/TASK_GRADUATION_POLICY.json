{
  "schema_version": 1,
  "authority": "Docs/Production/PRODUCTION_ARCHITECTURE_V32_STANDARD.md",
  "transitions": {
    "PREPARED_to_ASSIGNED": {
      "required": [
        "dependencies_approved",
        "canonical_packet",
        "frozen_scope",
        "registered_workstream",
        "owner",
        "isolated_branch",
        "owned_path_reservation",
        "activation_checklist",
        "critic_contract",
        "no_required_external_blocker",
        "control_plane_lineage"
      ],
      "rule": "Ownership may be claimed only after all requirements pass, including proof that the authoritative integration/control-plane head is an ancestor of the builder head."
    },
    "ASSIGNED_to_BUILDING_ISOLATED": {
      "required": [
        "assigned_gate_pass",
        "graduation_manifest",
        "early_sentinel_adapter",
        "focused_tests",
        "timeout_stage_plan",
        "execution_checkpoint",
        "critic_package_preflight_contract"
      ],
      "rule": "Authoritative runtime construction starts only after proof machinery is ready."
    },
    "REVIEW_to_INTEGRATION_READY": {
      "required": [
        "exact_candidate_frozen",
        "zero_primitive_shipping_art",
        "source_bound_final_visual_evidence",
        "native_4k_visual_proof",
        "motion_visual_proof_60fps",
        "explicit_user_visual_signoff",
        "mandatory_critics_pass",
        "zero_unresolved_mandatory_defects"
      ],
      "rule": "No visual task may become INTEGRATION_READY until the exact candidate is primitive-free and the user has inspected and explicitly approved exact-source final visuals. Signoff is governance-only and must not alter the frozen candidate SHA."
    }
  },
  "graduation_manifest_fields": [
    "task_id",
    "sentinel_adapter",
    "focused_tests",
    "task_workflow",
    "checkpoint_path",
    "critic_preflight_command",
    "stage_plan_command",
    "failure_router_command",
    "canary_command"
  ],
  "external_blockers_fail_closed": true,
  "governance_only_base_drift_may_reconcile_without_runtime_reset": true,
  "workflow_required_tokens": [
    "havenline-v32-task-preflight.yml",
    "mode: preflight",
    "target: BUILDING_ISOLATED",
    "candidate:",
    "mode: failure",
    "failed_run_id:",
    "failure()",
    "actions: read",
    "gate_result_recorder.py"
  ],
  "specialist_fanout_critics": [
    "C3",
    "C4",
    "C5",
    "C7",
    "C8",
    "C10",
    "C11"
  ],
  "performance_ledger_required_when_critic": "C6",
  "shared_control_workflow": ".github/workflows/havenline-v32-task-preflight.yml",
  "specialist_review_tokens": [
    "mode: review",
    "evidence_artifact_prefix:",
    "output_artifact_prefix:"
  ],
  "governance_only_base_drift_may_skip_control_plane_sync": false,
  "assignment_lineage_policy": {
    "current_integration_must_be_ancestor_of_builder": true,
    "exact_builder_head_required": true,
    "exact_integration_head_required": true,
    "governance_only_drift_preserves_prepared_runtime_work": true,
    "governance_only_drift_still_requires_control_plane_sync": true,
    "runtime_or_contract_drift_requires_reconciliation": true,
    "claim_binding_fields": [
      "assignment_integration_commit",
      "assignment_branch_head",
      "assignment_lineage_state"
    ]
  },
  "assignment_claim_tool": "tools/havenline/production/v32_assignment_claim.py",
  "legacy_assignment_claim_for_t11_t70_forbidden": true,
  "shipping_visual_policy": "Docs/Production/SHIPPING_VISUAL_APPROVAL_POLICY.json",
  "approval_invalidation_index": "Docs/Production/APPROVAL_INVALIDATIONS.json",
  "visual_signoff_template": "Docs/Production/FINAL_VISUAL_SIGNOFF_TEMPLATE.json",
  "historical_approval_is_not_effective_when_invalidated": true
}
