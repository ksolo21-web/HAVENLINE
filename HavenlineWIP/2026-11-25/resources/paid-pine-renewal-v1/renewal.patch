+extends "res://previews/integrated_opening.gd"
+## Test-only observation at the ordinary settled handoff. Attempts invalid
+## provenance before delegating the exact event to the real scene receiver.
+var observed_tickets: Array[RefCounted] = []
+var all_forged_denied := true
+
+func _collect_paid_pine(source: String, ticket: RefCounted) -> bool:
+	if ticket == _pine_ticket and ticket != null:
+		all_forged_denied = all_forged_denied and not super._collect_paid_pine("wood-b", ticket)
+		all_forged_denied = all_forged_denied and not super._collect_paid_pine(source, RefCounted.new())
+		var original: Dictionary = _pine_receipt
+		_pine_receipt = {"offer": "wrong"}
+		all_forged_denied = all_forged_denied and not super._collect_paid_pine(source, ticket)
+		_pine_receipt = original
+		observed_tickets.append(ticket)
+	return super._collect_paid_pine(source, ticket)
