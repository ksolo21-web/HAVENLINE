+		if tree.phase == "credited" or game.persist_blocked:
+			break
+		await tick(1)
+	check(game.ledger.stock.wood == wood_after, "expected paid-or-visual stock after settling: %d" % wood_after)
+	if not game.persist_blocked:
+		check(tree.phase == "credited" and not tree.get_child(0).is_visible_in_tree(), "settled pine disappears")
+
+func approach() -> void:
+	check(await travel(game.point([-.35, 6.])), "walk to exact east tree approach")
+	check(await travel(game.point([-.85, 6.])), "walk remaining westbound reach")
+	check(game.resource_tree.can_address(game.actor.global_position, game.tree_facing()), "original facing/range gate")
+
+func regrow(wood: int) -> void:
