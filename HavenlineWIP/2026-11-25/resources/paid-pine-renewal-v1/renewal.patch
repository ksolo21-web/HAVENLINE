+func settle(wood_before: int, wood_after: int, first_already := false) -> void:
+	var tree = game.resource_tree
+	for i in range(1 if first_already else 0, 2):
+		press(KEY_F)
+		await tick(21)
+		check(tree.strikes == i + 1 and tree.phase == "rooted" and game.ledger.stock.wood == wood_before, "accepted strike %d does not pay" % (i + 1))
+	press(KEY_F)
+	press(KEY_F)
