+extends RefCounted
+## Reference-only production art: exact indexed terrain triangles clipped to
+## a 1.40 m visual field only. Purchase still uses the separate .72 m anchor.
+const GRID = preload("res://accepted_t02_surface.gd")
+const TERRAIN = preload("res://terrain_source.gd")
+const SURFACE_ART = preload("res://previews/plot_art/construction_three_wood.svg")
+const FIELD := 1.40
+const FLUSH_GAP := .009
+
+static func build(anchor: Vector3, wood_cost: int) -> MeshInstance3D:
+	# This specific reviewed icon has a vector "3". A pricing change must
+	# supply updated art; no stale visible price may authorize a purchase.
+	if wood_cost != 3 or not anchor.is_finite():
+		return null
+	var center := Vector2(anchor.x, anchor.z)
+	var low := center - Vector2.ONE * FIELD * .5
+	var high := center + Vector2.ONE * FIELD * .5
+	var span := GRID.STEP
+	var start := Vector2i(((low + Vector2.ONE * GRID.HALF) / span).floor())
+	var end := Vector2i(((high + Vector2.ONE * GRID.HALF) / span).ceil())
+	var positions := PackedVector3Array()
+	var uv := PackedVector2Array()
+	for z in range(start.y, end.y):
+		for x in range(start.x, end.x):
+			var a := Vector2(x,z) * span - Vector2.ONE * GRID.HALF
+			var b := a + Vector2(span,0)
+			var c := a + Vector2(0,span)
+			var d := a + Vector2.ONE * span
+			# Same diagonal and winding as AcceptedGround's indexed source.
+			var first: Array[Vector2] = [a,b,c]
+			var second: Array[Vector2] = [b,d,c]
+			for source: Array[Vector2] in [first,second]:
+				var poly: Array[Vector2] = source
+				poly = _clip(poly, 0, low.x, true)
+				poly = _clip(poly, 0, high.x, false)
+				poly = _clip(poly, 1, low.y, true)
+				poly = _clip(poly, 1, high.y, false)
+				for i in range(1, poly.size() - 1):
+					if absf((poly[i] - poly[0]).cross(poly[i+1] - poly[0])) < .00000002:
+						continue
+					for p: Vector2 in [poly[0], poly[i], poly[i+1]]:
+						var sample := TERRAIN.sample(p)
+						if not sample.get("valid",false) or not sample.get("dry",false) or not is_finite(float(sample.height)):
+							return null
+						positions.append(Vector3(p.x-anchor.x,float(sample.height)-anchor.y+FLUSH_GAP,p.y-anchor.z))
+						uv.append((p-low)/FIELD)
+	if positions.is_empty():
+		return null
+	var arrays: Array = []
+	arrays.resize(Mesh.ARRAY_MAX)
+	arrays[Mesh.ARRAY_VERTEX] = positions
+	arrays[Mesh.ARRAY_TEX_UV] = uv
+	var mesh := ArrayMesh.new()
+	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+	var paint := StandardMaterial3D.new()
+	paint.albedo_texture = SURFACE_ART
+	paint.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	paint.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
+	paint.alpha_scissor_threshold = .42
+	paint.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
+	var marker := MeshInstance3D.new()
+	marker.name = "ReferenceConstructionPlot"
+	marker.mesh = mesh
+	marker.material_override = paint
+	marker.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	return marker
+
+static func _clip(input: Array[Vector2], axis: int, bound: float, keep_high: bool) -> Array[Vector2]:
+	var out: Array[Vector2] = []
+	if input.is_empty():
+		return out
+	var previous := input.back() as Vector2
+	var previous_inside := previous[axis] >= bound if keep_high else previous[axis] <= bound
+	for current in input:
+		var inside := current[axis] >= bound if keep_high else current[axis] <= bound
+		if inside != previous_inside:
+			var t := (bound - previous[axis]) / (current[axis] - previous[axis])
+			out.append(previous.lerp(current, t))
+		if inside:
+			out.append(current)
+		previous = current
+		previous_inside = inside
+	return out
