+extends "res://tests/test_integrated_opening.gd"
+
+func repeat_gate(condition: String) -> void:
+	game = GAME.instantiate()
+	root.add_child(game)
+	await tick(7)
+	var plot: MeshInstance3D = game.purchase_pad_view.scene_view.get_node("ReferenceConstructionPlot")
+	var anchor: Vector3 = game.pad_anchor
+	check(await travel(game.wood_anchors["wood-b"]), "first pickup ordinary "+condition)
+	check(await travel(game.wood_anchors["wood-c"]), "second pickup ordinary "+condition)
+	check(await travel(game.point([-.35,6.0])) and await travel(game.point([-.85,6.0])),"ordinary tree reach "+condition)
+	for i in 3:
+		press(KEY_F)
+		await tick(21)
+	check(await travel(game.point([0.0,6.0])), "clear native tree sweep "+condition)
+	await tick(58)
+	check(game.ledger.stock.wood == 3 and game.ledger.receipt.is_empty(),"full stock before approaching plot "+condition)
+	var adapter: Node3D = plot.get_parent()
+	match condition:
+		"hidden":
+			plot.hide()
+		"detached":
+			adapter.remove_child(plot)
+		"reparented":
+			plot.reparent(game)
+		"impostor":
+			var counterfeit := plot.duplicate() as MeshInstance3D
+			adapter.remove_child(plot)
+			counterfeit.name = "ReferenceConstructionPlot"
+			adapter.add_child(counterfeit)
+			check(counterfeit.is_visible_in_tree(), "counterfeit attached with indistinguishable mesh/name")
+		"freed":
+			plot.free()
+		"mesh-swapped":
+			plot.mesh = plot.mesh.duplicate()
+		"moved-offsite":
+			plot.position.x += 1.0
+		"hidden-by-camera":
+			game.camera.cull_mask &= ~plot.layers
+		"fully-transparent":
+			plot.transparency = 1.0
+		"failed-binding":
+			game.purchase_pad_view.binding_ready=false
+	if condition != "valid":
+		await process_frame
+		await process_frame
+		check(not game.opening_hud.prompt.text.contains("3 wood") and not game.opening_hud.plot_cost_accessible, "ordinary frame removes stale affordability cue for "+condition)
+	check(await travel(anchor), "actor moves into exact purchase location "+condition)
+	await tick(4)
+	if condition == "valid":
+		check(game.ledger.stock.wood == 0 and game.ledger.receipt.get("typed_debit") == {"wood":3} and not plot.is_visible_in_tree(),"normal marker pays exactly three and vanishes")
+	else:
+		check(game.ledger.stock.wood == 3 and game.ledger.receipt.is_empty() and not game.camp_built.visible,"withheld preview cannot debit from invisible space "+condition)
+		if condition in ["detached","impostor"]:
+			plot.free()
+	game.queue_free()
+	await process_frame
+
+func run() -> void:
+	root.size=Vector2i(1280,720)
+	await process_frame
+	for scenario in ["hidden","detached","reparented","impostor","freed","mesh-swapped","moved-offsite","hidden-by-camera","fully-transparent","failed-binding","valid"]:
+		await repeat_gate(scenario)
+	print("REFERENCE GUARD checks=",checks," failures=",failures)
+	quit(1 if failures else 0)
