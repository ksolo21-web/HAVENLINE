+extends "res://fixtures/pine_store/under_test.gd"
+## Private integration seam only: no world receiver, asset, placement or interaction.
+const Composite = preload("res://fixtures/pine_store/ledger.gd")
+const Backend = preload("res://fixtures/pine_store/store.gd")
+var storage := Backend.new()
+var _fixture_ticket: RefCounted
+var _fixture_stamp: Dictionary = {}
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	# Never even open the original save path for this fixture.
+	if save.requested(args) or not storage.configure(args):
+		bound = false
+		return
+	var restored := storage.boot()
+	if restored == null:
+		bound = false
+		return
+	ledger = restored
+	super._ready()
+
+func _fixture_next_ledger() -> Ledger:
+	return Composite.new()
+
+func _commit_opening_progress(next: Ledger) -> bool:
+	# A shared baseline starter helper still stages its exact v1 payload. Adapt
+	# it through the same validated binder, not a new game ingress.
+	var proposal := Composite.new()
+	if not proposal.restore(next.snapshot()) or not storage.commit(proposal):
+		persist_blocked = true
+		persist_error = "Fixture save rejected before publication."
+		refresh_hud()
+		return false
+	return super._commit_opening_progress(proposal)
+
+func fixture_issue_owned_deposit(id: int, material: String, n: int) -> RefCounted:
+	if _fixture_ticket != null or not bound or persist_blocked or id != 1 or material != "wood" or n != 1:
+		return null
+	if not ledger.has_exact_paid_hearth() or ledger.deposit_through != 0 or ledger.stock.wood != 2 or ledger.pine_occurrences != 2:
+		return null
+	_fixture_stamp = ledger.snapshot()
+	_fixture_ticket = RefCounted.new()
+	return _fixture_ticket
+
+func fixture_publish_owned_deposit(ticket: RefCounted) -> bool:
+	if _fixture_ticket == null or ticket != _fixture_ticket or persist_blocked or not bound or ledger.snapshot() != _fixture_stamp:
+		return false
+	var next := Composite.new()
+	if not next.restore(_fixture_stamp) or not next.fixture_record_deposit(1, "wood", 1):
+		return false
+	_fixture_stamp.clear()
+	_fixture_ticket = null
+	return _commit_opening_progress(next)
