+extends "res://tests/test_paid_pine_renewal.gd"
+const Fixture = preload("res://fixtures/pine_store/opening.gd")
+const Backend = preload("res://fixtures/pine_store/store.gd")
+const Composite = preload("res://fixtures/pine_store/ledger.gd")
+const PHASE := "--pine-store-test-phase="
+const EXPECTED := {"offer": "center-hearth", "grant": "center-hearth", "revision": 1, "typed_debit": {"wood": 3}}
+var mode := "route"
+
+func assert_fixture_state(occurrences: int, carried: int, stored: int, phase_note: String) -> void:
+	check(game.ledger.has_exact_paid_hearth() and game.ledger.receipt == EXPECTED, phase_note + " exact original receipt")
+	check(game.ledger.pine_occurrences == occurrences and game.ledger.stock.wood == carried and game.ledger.stored_wood == stored, phase_note + " typed values")
+	check(game.ledger.deposit_through == (0 if stored == 0 else 1), phase_note + " exact deposit high-water")
+
+func original_wood_and_paid_twice() -> void:
+	for id in ["wood-b", "wood-c"]:
+		check(await travel(game.wood_anchors[id]), "ordinary pickup route " + id)
+	await approach()
+	await settle(2, 3)
+	check(game.ledger.collected == ["wood-b", "wood-c", "wood-a"], "exact original starter ids")
+	check(await travel(game.pad_anchor), "walk to native paid fixture's unchanged game pad")
+	check(game.camp_built.visible and game.ledger.has_exact_paid_hearth() and game.ledger.snapshot().version == 1 and game.ledger.stock.wood == 0, "paid exact three; legacy v1 persisted")
+	await cross_south()
+	# Full absence allowance (do not alter original 5s tree clock if partly run
+	# during payment + the gate walk). Watch body motion/route like parent test.
+	await tick(300)
+	check(game.resource_tree.phase == "rooted" and game.ledger.stock.wood == 0, "regrowth alone still earns nothing")
+	for i in range(1, 3):
+		await approach()
+		await settle(i - 1, i)
+		assert_fixture_state(i, i, 0, "ordinary paid harvested %d" % i)
+		if i == 1:
+			await regrow(i)
+	check(game.ledger.snapshot().version == 2, "strict unchanged-shape v2 before deposit")
+
+func deposit_and_guard() -> void:
+	var old := Backend.new()
+	check(old.configure(OS.get_cmdline_user_args()), "shadow backend exact owner marker")
+	var read := old._decode(old.primary_path())
+	# Read-only imitation of a retained session against the same primary hash.
+	old._epoch = read.get("epoch", 0)
+	old._published_hash = read.get("identity", "")
+	var before := FileAccess.get_file_as_bytes(old.primary_path())
+	var expected: Dictionary = game.ledger.snapshot()
+	check(game.fixture_issue_owned_deposit(2, "wood", 1) == null and game.fixture_issue_owned_deposit(1, "food", 1) == null and game.fixture_issue_owned_deposit(1, "wood", 2) == null, "skipped/wrong type and oversized fixture requests denied")
+	var token: RefCounted = game.fixture_issue_owned_deposit(1, "wood", 1)
+	check(token != null and not game.fixture_publish_owned_deposit(RefCounted.new()) and expected == game.ledger.snapshot(), "fake ticket does not spend or consume live fixture ticket")
+	if mode == "forced_abort":
+		var path: String = old.stage_path()
+		check(DirAccess.make_dir_absolute(path) == OK, "own staging path blocked before promotion")
+		check(not game.fixture_publish_owned_deposit(token) and game.persist_blocked and game.ledger.snapshot() == expected and before == FileAccess.get_file_as_bytes(old.primary_path()), "failed staging leaves exact v2 primary wood and receipt")
+		check(DirAccess.remove_absolute(path) == OK, "own blocker directory removed")
+		return
+	check(game.fixture_publish_owned_deposit(token), "one abstract fixture deposit committed")
+	assert_fixture_state(2, 1, 1, "after deposit")
+	check(not game.fixture_publish_owned_deposit(token) and game.fixture_issue_owned_deposit(1, "wood", 1) == null, "actual previously consumed ticket and ID denied")
+	var proposal := Composite.new()
+	check(proposal.restore(expected), "validated stale shadow snapshot")
+	var fresh := FileAccess.get_file_as_bytes(old.primary_path())
+	check(fresh != before and not old.commit(proposal) and fresh == FileAccess.get_file_as_bytes(old.primary_path()), "same-epoch old published identity cannot clobber deposit")
+	var live_store: Backend = game.storage
+	var held_old_epoch: int = live_store._epoch
+	var holder := Backend.new()
+	check(holder.configure(OS.get_cmdline_user_args()) and holder.boot() != null, "simulated second fixture owner epoch, same process canonical guard")
+	var moved := FileAccess.get_file_as_bytes(old.primary_path())
+	check(holder._epoch == held_old_epoch + 1 and not live_store.commit(proposal) and moved == FileAccess.get_file_as_bytes(old.primary_path()), "prior epoch cannot overwrite new epoch")
+	check(game.ledger.snapshot().version == 3, "only actual deposit introduces fixture v3")
+	var forged: Dictionary = game.ledger.snapshot()
+	forged.carried.wood += 1
+	check(not proposal.restore(forged) and proposal.snapshot() == expected, "synthetic malformed v3 cannot alter validated ledger")
+
+func resume_and_harvest() -> void:
+	assert_fixture_state(2, 1, 1, "new process restores v3")
+	check(game.camp_built.visible and game.actor.position.is_equal_approx(game.point(game.layout.start_xz)) and game.actor.basis.is_equal_approx(Basis.IDENTITY), "restore keeps actual original spawn/basis and camp")
+	await tick(300)
+	# SceneTree.physics_frame is observed before the node's current callback;
+	# the cold ready frame provides no settled phase baseline clock.
+	check(game.ledger.stock.wood == 1, "restored five seconds offers no passive award")
+	await tick(1)
+	check(game.resource_tree.phase == "rooted" and game.ledger.stock.wood == 1, "rooted after the final cold-start callback adds no wood")
+	await approach()
+	await settle(1, 2)
+	assert_fixture_state(3, 2, 1, "next ordinary full paid cut")
+	var observed: Dictionary = game.storage._decode(game.storage.primary_path())
+	check(observed.get("ledger") == game.ledger.snapshot(), "cold successor primary and native authority exactly agree")
+
+func run() -> void:
+	for arg in OS.get_cmdline_user_args():
+		if arg.begins_with(PHASE):
+			mode = arg.trim_prefix(PHASE)
+	game = GAME.instantiate()
+	game.set_script(Fixture)
+	root.add_child(game)
+	if mode == "invalid_owner":
+		check(not game.bound and game.actor == null, "wrong fixture ownership refused before scene; no original save opened")
+		quit(1 if failures else 0)
+		return
+	check(game.bound and not game.persist_requested and not game.persist_blocked, "fixture loads only marked native profile; exact game otherwise bound")
+	if not game.bound:
+		quit(1)
+		return
+	if mode == "resume":
+		await resume_and_harvest()
+	elif mode == "read_v1":
+		assert_fixture_state(0, 0, 0, "native legacy v1 wrapper")
+		check(game.ledger.snapshot().version == 1, "v1 unchanged after wrapper migration")
+	elif mode == "read_v2" or mode == "read_abort":
+		assert_fixture_state(2, 2, 0, "native legacy v2 or aborted deposit read")
+		check(game.ledger.snapshot().version == 2, "no deposit recovered from v2")
+	else:
+		await tick(10)
+		await original_wood_and_paid_twice()
+		await deposit_and_guard()
+	print("pine-store native fixture checks=", checks, " failures=", failures, " grounded=", grounded)
+	quit(1 if failures else 0)
