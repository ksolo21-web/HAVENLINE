+extends "res://opening_ledger.gd"
+## Test-only composite adapter. Before the fixture's one deposit, exact legacy shape.
+var stored_wood := 0
+var deposit_through := 0
+
+func _advance_fields() -> Dictionary:
+	return {"version": 3, "collected": collected.duplicate(), "receipt": receipt.duplicate(true),
+		"harvest_through": pine_occurrences, "deposit_through": deposit_through,
+		"carried": stock.duplicate(true), "stored": {"wood": stored_wood}}
+
+func snapshot() -> Dictionary:
+	return super.snapshot() if deposit_through == 0 else _advance_fields()
+
+func restore(data: Variant) -> bool:
+	if not data is Dictionary:
+		return false
+	if not _whole(data.get("version"), 3):
+		if not super.restore(data):
+			return false
+		stored_wood = 0
+		deposit_through = 0
+		return true
+	if data.size() != 7 or not _whole(data.get("deposit_through"), 1):
+		return false
+	var harvest: Variant = data.get("harvest_through")
+	var carried: Variant = data.get("carried")
+	var stored: Variant = data.get("stored")
+	if not carried is Dictionary or carried.size() != 1 or not stored is Dictionary or stored.size() != 1:
+		return false
+	if not _count(harvest) or not _count(carried.get("wood")) or not _whole(stored.get("wood"), 1):
+		return false
+	if int(harvest) < 1 or int(carried.wood) + 1 != int(harvest):
+		return false
+	# Preserve old starter-ID and typed paid-receipt validation via the exact original v2 gate.
+	var legacy := {"version": 2, "collected": data.get("collected"), "receipt": data.get("receipt"),
+		"pine_occurrences": int(harvest), "stock": {"wood": int(harvest)}}
+	if not super.restore(legacy):
+		return false
+	stock = {"wood": int(carried.wood)}
+	stored_wood = 1
+	deposit_through = 1
+	return true
+
+func _count(n: Variant) -> bool:
+	if typeof(n) != TYPE_INT and typeof(n) != TYPE_FLOAT:
+		return false
+	return is_finite(float(n)) and n >= 0 and n <= MAX_PINE_OCCURRENCES and _whole(n, int(n))
+
+func has_exact_paid_hearth() -> bool:
+	if deposit_through == 0:
+		return super.has_exact_paid_hearth()
+	return deposit_through == 1 and stored_wood == 1 and receipt == _completed_receipt() and collected.size() == KNOWN_WOOD.size() and KNOWN_WOOD.all(func(id): return id in collected) and _count(stock.get("wood")) and stock.wood + stored_wood == pine_occurrences
+
+func _record_paid_pine(source: String, occurrence: int, expected_receipt: Dictionary) -> bool:
+	if deposit_through == 0:
+		return super._record_paid_pine(source, occurrence, expected_receipt)
+	if source != "wood-a" or not has_exact_paid_hearth() or receipt != expected_receipt or pine_occurrences >= MAX_PINE_OCCURRENCES or occurrence != pine_occurrences + 1:
+		return false
+	pine_occurrences = occurrence
+	stock.wood += 1
+	return true
+
+func fixture_record_deposit(id: int, material: String, n: int) -> bool:
+	if id != 1 or material != "wood" or n != 1 or deposit_through != 0 or not has_exact_paid_hearth() or stock.wood < 1:
+		return false
+	stock.wood -= 1
+	stored_wood = 1
+	deposit_through = 1
+	return true
