+extends RefCounted
+## Disposable native profile only. The approved shell runner holds a separate
+## process-wide OS flock. This script does not implement directory fsync.
+const L = preload("res://fixtures/pine_store/ledger.gd")
+const FLAG := "--pine-store-fixture="
+const OWNER := "--pine-store-owner="
+const PREFIX := "havenline-pine-store-fixture-"
+const MARK := "PINE-STORE-TEST-OWNER"
+const PRIMARY := "pine-store-fixture.json"
+const STAGE := "pine-store-fixture.stage"
+const PIN := "e88468b70209be294e23a03b5200dcd60d9a69c71116f77637efbd960935efbd"
+var _root := ""
+var _owner := ""
+var _epoch := 0
+var _published_hash := ""
+
+func _matches(args: PackedStringArray, flag: String) -> PackedStringArray:
+	var out := PackedStringArray()
+	for arg in args:
+		if arg.begins_with(flag):
+			out.append(arg.trim_prefix(flag))
+	return out
+
+func configure(args: PackedStringArray) -> bool:
+	_root = ""
+	_owner = ""
+	_epoch = 0
+	_published_hash = ""
+	var paths := _matches(args, FLAG)
+	var owners := _matches(args, OWNER)
+	if paths.size() != 1 or owners.size() != 1:
+		return false
+	var leaf := paths[0].get_file()
+	var regex := RegEx.new()
+	if regex.compile("^" + PREFIX + "[A-Za-z0-9_-]{8,48}$") != OK or regex.search(leaf) == null or paths[0] != "/tmp/" + leaf:
+		return false
+	if regex.compile("^[0-9a-f]{32}$") != OK or regex.search(owners[0]) == null:
+		return false
+	_root = paths[0]
+	_owner = owners[0]
+	if not _safe():
+		_root = ""
+		_owner = ""
+		return false
+	return true
+
+func _safe() -> bool:
+	if _root.is_empty():
+		return false
+	var t := DirAccess.open("/tmp")
+	var d := DirAccess.open(_root)
+	if t == null or t.is_link(_root.get_file()) or d == null or d.is_link(MARK) or d.is_link(PRIMARY) or d.is_link(STAGE):
+		return false
+	var mark := FileAccess.open(_root.path_join(MARK), FileAccess.READ)
+	var expected := "HAVENLINE-PINE-NATIVE-FIXTURE\n" + PIN + "\n" + _owner + "\n"
+	return mark != null and mark.get_length() == expected.length() and mark.get_as_text() == expected
+
+func _decode(path: String) -> Dictionary:
+	var f := FileAccess.open(path, FileAccess.READ)
+	if f == null or f.get_length() > 8192:
+		return {}
+	var raw := f.get_as_text()
+	var data: Variant = JSON.parse_string(raw)
+	if not data is Dictionary or data.size() != 3 or data.get("version") != 1:
+		return {}
+	var payload: Variant = data.get("payload")
+	if not payload is String or payload.sha256_text() != data.get("sha256"):
+		return {}
+	var p: Variant = JSON.parse_string(payload)
+	if not p is Dictionary:
+		return {}
+	var ledger := L.new()
+	if p.has("fixture"):
+		if p.size() != 4 or p.get("fixture") != 1 or p.get("owner") != _owner or not ledger._count(p.get("epoch")) or int(p.epoch) < 1 or not ledger.restore(p.get("ledger")):
+			return {}
+		return {"epoch": int(p.epoch), "ledger": ledger.snapshot(), "identity": raw.sha256_text()}
+	if not ledger.restore(p) or not (L._whole(p.get("version"), 1) or L._whole(p.get("version"), 2)):
+		return {}
+	return {"epoch": 0, "ledger": ledger.snapshot(), "identity": raw.sha256_text()}
+
+func primary_path() -> String:
+	return _root.path_join(PRIMARY)
+func stage_path() -> String:
+	return _root.path_join(STAGE)
+
+func _write(next: L, epoch: int) -> bool:
+	if not _safe():
+		return false
+	var text := JSON.stringify({"fixture": 1, "owner": _owner, "epoch": epoch, "ledger": next.snapshot()})
+	var raw := JSON.stringify({"version": 1, "payload": text, "sha256": text.sha256_text()})
+	var d := DirAccess.open(_root)
+	if d.file_exists(STAGE) and d.remove(STAGE) != OK:
+		return false
+	var f := FileAccess.open(stage_path(), FileAccess.WRITE)
+	if f == null:
+		return false
+	f.store_string(raw)
+	f.flush()
+	var result := f.get_error()
+	f.close()
+	var checked := _decode(stage_path())
+	if result != OK or checked.get("ledger") != next.snapshot() or checked.get("epoch") != epoch or checked.get("identity") != raw.sha256_text() or not _safe():
+		return false
+	if DirAccess.rename_absolute(stage_path(), primary_path()) != OK:
+		return false
+	_published_hash = raw.sha256_text()
+	_epoch = epoch
+	return true
+
+func boot() -> L:
+	if not _safe():
+		return null
+	var next := L.new()
+	var epoch := 1
+	if FileAccess.file_exists(primary_path()):
+		var data := _decode(primary_path())
+		if data.is_empty() or not next.restore(data.ledger) or int(data.epoch) >= L.MAX_PINE_OCCURRENCES:
+			return null
+		epoch += int(data.epoch)
+	return next if _write(next, epoch) else null
+
+func commit(next: L) -> bool:
+	if _epoch <= 0 or not _safe():
+		return false
+	var previous := _decode(primary_path())
+	if previous.get("epoch") != _epoch or previous.get("identity") != _published_hash:
+		return false
+	return _write(next, _epoch)
