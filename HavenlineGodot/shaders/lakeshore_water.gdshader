shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
// Opaque bounded river water. UV.x is cumulative distance along the west->east
// river and UV.y is cross-channel position generated by outpost_surface.gd.
uniform float sim_time=0.0;
void fragment(){
 vec2 f=UV;
 float edge=min(f.y,1.-f.y)*2.;
 float depth=smoothstep(.05,.52,edge);
 vec3 base=mix(vec3(.05,.63,.86),vec3(.002,.40,.77),depth);
 // Current patterns translate in +U, visually reinforcing west->east flow.
 float a=sin(f.x*18.0+f.y*5.0-sim_time*.95);
 float b=sin(f.x*11.0-f.y*8.0-sim_time*.56);
 float caustic=pow(clamp((a+b)*.25+.5,0.,1.),7.0);
 float stroke=pow(.5+.5*sin(f.x*15.0+f.y*2.4-sim_time*.72+sin(f.y*8.0)*.14),12.);
 base+=vec3(.006,.022,.028)*caustic+vec3(.003,.012,.021)*stroke;
 float shoreline=1.-smoothstep(.0,.12,edge);
 base=mix(base,vec3(.49,.87,.95),shoreline*.055);
 ALBEDO=pow(base,vec3(2.2));ROUGHNESS=.54;SPECULAR=.12;
 float nx=cos(f.x*18.0+f.y*5.0-sim_time*.95)*.035;
 float ny=cos(f.x*11.0-f.y*8.0-sim_time*.56)*.045;
 NORMAL_MAP=normalize(vec3(nx,ny,1.0))*.5+.5;
 NORMAL_MAP_DEPTH=.4;
}
